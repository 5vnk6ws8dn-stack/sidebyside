# Side by Side Player — Cloudflare headers
# Author: ©Simon Z. Chan  ·  Version: 1.2.1  ·  Build: 2026-11-11 12:17 EST (UTC−05:00)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; media-src 'self' blob:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: no-cache
